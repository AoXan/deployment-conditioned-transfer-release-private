  "properties": {
    "sample_id": {"type": "string"},
    "y_true": {"type": "number"},
    "y_pred": {"type": "number"},
    "split_id": {"type": "string", "enum": ["GROUP", "SPATIAL"]},
    "seed": {"type": "integer"}
  },
  "additionalProperties": true
}
